<Window x:Class="GamerCompanion.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Settings" Height="600" Width="400"
        ResizeMode="NoResize">
    <StackPanel Margin="15">
        <TextBlock Text="General" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

        <TextBlock Text="Log folder:"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="LogFolderBox" Width="280" Margin="0,0,5,0"/>
            <Button Content="..." Click="BrowseFolder_Click"/>
        </StackPanel>

        <TextBlock Text="Update interval (ms):"/>
        <ComboBox x:Name="IntervalCombo" Margin="0,0,0,15"
                  ItemsSource="{Binding AvailableIntervals}"/>

        <TextBlock Text="Theme:" />
        <ComboBox x:Name="ThemeCombo" Margin="0,0,0,15">
            <ComboBoxItem Content="Dark"/>
            <ComboBoxItem Content="Light"/>
            <ComboBoxItem Content="System"/>
        </ComboBox>

        <CheckBox Content="Auto-logging when app is running" 
          x:Name="AutoLoggingCheck"
          Margin="0,0,0,10"/>

        <TextBlock Text="Thresholds" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="CPU Temp (°C):"/>
                <TextBox x:Name="CpuTempBox" Margin="0,0,5,8"/>
                <TextBlock Text="CPU Load (%):"/>
                <TextBox x:Name="CpuLoadBox" Margin="0,0,5,8"/>
                <TextBlock Text="RAM Usage (%):"/>
                <TextBox x:Name="RamBox" Margin="0,0,5,8"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="GPU Temp (°C):"/>
                <TextBox x:Name="GpuTempBox" Margin="0,0,0,8"/>
                <TextBlock Text="GPU Load (%):"/>
                <TextBox x:Name="GpuLoadBox" Margin="0,0,0,8"/>
            </StackPanel>
        </Grid>

        <Button Content="Save" Click="Save_Click" HorizontalAlignment="Right" Margin="0,10,0,0"/>
    </StackPanel>
</Window>