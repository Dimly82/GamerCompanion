<Window x:Class="GamerCompanion.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GamerCompanion.Views"
        xmlns:vm="clr-namespace:GamerCompanion.ViewModels"
        mc:Ignorable="d"
        Title="Gamer Companion" Height="450" Width="800">
    <Window.DataContext>
        <vm:MonitoringViewModel/>
    </Window.DataContext>
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="{Binding CpuLoad, StringFormat='CPU: {0:F1}%'}" FontSize="16" Margin="5"/>
            <TextBlock Text="{Binding RamUsed, StringFormat='RAM: {0:F1} GB'}" FontSize="16" Margin="5"/>
            <TextBlock Text="{Binding GpuLoad, StringFormat='GPU: {0:F1}%'}" FontSize="16" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
