<Window x:Class="GamerCompanion.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GamerCompanion.Views"
        xmlns:vm="clr-namespace:GamerCompanion.ViewModels"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Gamer Companion" Height="450" Width="800">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <TabControl Margin="10">
        <TabItem Header="Monitoring">
            <Grid Margin="10" DataContext="{Binding Monitoring}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding CpuName}" FontSize="12" FontWeight="Bold" Margin="5,5,5,0"/>
                        <TextBlock Text="{Binding CpuLoad, StringFormat='Load: {0:F1}%'}" FontSize="14" Margin="5,0,5,0"/>
                        <Expander Header="CPU Graph" IsExpanded="False" Margin="5,0,5,0">
                            <lvc:CartesianChart Series="{Binding CpuLoadSeries}" Height="150" LegendPosition="Hidden" Padding="10"/>
                        </Expander>
                        <TextBlock Text="{Binding CpuTemp, StringFormat='Temperature: {0:F1} °C'}" FontSize="14" Margin="5,0,5,5"/>

                        <TextBlock Text="{Binding GpuName}" FontSize="12" FontWeight="Bold" Margin="5,5,5,0"/>
                        <TextBlock Text="{Binding GpuLoad, StringFormat='Load: {0}%'}" FontSize="14" Margin="5,0,5,0"/>
                        <Expander Header="GPU Graph" IsExpanded="False" Margin="5,0,5,0">
                            <lvc:CartesianChart Series="{Binding GpuLoadSeries}" Height="150" LegendPosition="Hidden" Padding="10"/>
                        </Expander>
                        <TextBlock Text="{Binding GpuTemp, StringFormat='Temperature: {0} °C'}" FontSize="14" Margin="5,0,5,0"/>
                        <TextBlock Text="{Binding GpuMemStatus, StringFormat='Memory: {0}'}" FontSize="14" Margin="5,0,5,5"/>

                        <TextBlock Text="RAM" FontSize="12" FontWeight="Bold" Margin="5,5,5,0"/>
                        <TextBlock Text="{Binding RamStatus, StringFormat='Usage: {0}'}" FontSize="14" Margin="5,0,5,5"/>

                        <TextBlock Text="{Binding ActiveApp, StringFormat='Running App: {0}'}" FontSize="14" Margin="5"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Update interval (in ms):" VerticalAlignment="Center" Margin="0,0,5,0" Grid.Column="0"/>
                        <ComboBox SelectedValue="{Binding UpdateInterval}" ItemsSource="{Binding AvailableIntervals}" Grid.Column="1" VerticalAlignment="Center"/>

                        <Button Content="Apps" Command="{Binding ShowRegisteredGamesCommand}" Margin="10,0,10,0" VerticalAlignment="Center" Grid.Column="3"/>

                        <TextBlock Text="{Binding IsLogging, StringFormat='Logging Status: {0}'}" VerticalAlignment="Center" Margin="0,0,5,0" Grid.Column="4"/>
                        <Button Content="Toggle Logging" Command="{Binding ToggleLoggingCommand}" VerticalAlignment="Center" Grid.Column="5"/>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="Reminders">
            <StackPanel Margin="10" DataContext="{Binding Reminders}">
                <TextBlock Text="New Reminder:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBox Width="200" Text="{Binding NewReminderText}" ui:ControlHelper.PlaceholderText="Reminder text" Margin="0,0,5,0"/>
                    <TextBox Width="80" Text="{Binding NewReminderTimeMinutes}" ui:ControlHelper.PlaceholderText="Minutes"  Margin="0,0,5,0"/>
                    <CheckBox Content="Repeating" IsChecked="{Binding NewReminderRepeating}"/>
                    <Button Content="Add" Command="{Binding AddReminderCommand}"/>
                </StackPanel>

                <ListBox ItemsSource="{Binding Reminders}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="200" Text="{Binding Text}" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding TimeLeft}" VerticalAlignment="Center" Width="100"/>
                                <TextBlock Text="{Binding TargetTimeFormatted}" VerticalAlignment="Center" Width="100"/>
                                <Button Content="Remove" Command="{Binding DataContext.RemoveReminderCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </TabItem>
    </TabControl>

</Window>
