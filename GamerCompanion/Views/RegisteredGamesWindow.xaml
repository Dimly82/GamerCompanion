<Window x:Class="GamerCompanion.Views.RegisteredGamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GamerCompanion.Views"
        mc:Ignorable="d"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Registered Games" Height="300" Width="300">
    <StackPanel Margin="10">
        <TextBlock Text="Registered games (processes):" FontWeight="Bold" Margin="0,0,0,10"/>
        <ListBox ItemsSource="{Binding Games}" Height="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ProcessName, StringFormat=' ({0})'}" Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Close" Margin="0,10,0,0" Click="Close_Click"/>
    </StackPanel>
</Window>
